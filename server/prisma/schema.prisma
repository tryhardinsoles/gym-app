generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  isAdmin   Boolean  @default(false)
  plan      String   @default("start") // "start" | "performance"
  createdAt DateTime @default(now())

  routines        Routine[]
  workoutSessions WorkoutSession[]
  wellbeingLogs   WellbeingLog[]
  agendaBookings  AgendaBooking[]
  exerciseLogs    ExerciseLog[]
}

model AgendaSlot {
  id            String          @id @default(cuid())
  dayOfWeek     Int             // 0=Sun, 1=Mon … 6=Sat
  time          String          // "HH:MM"
  googleMeetUrl String?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())

  bookings AgendaBooking[]

  @@unique([dayOfWeek, time])
}

model AgendaBooking {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  slotId    String
  slot      AgendaSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  weekStart DateTime   // Monday 00:00:00 UTC of the booked week
  meetUrl   String?
  createdAt DateTime   @default(now())

  @@unique([slotId, weekStart])
}

model Routine {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  order       Int
  mes         Int       @default(1)
  completedAt DateTime?
  isLocked    Boolean   @default(false)
  createdAt   DateTime  @default(now())

  sections        RoutineSection[]
  workoutSessions WorkoutSession[]
}

model RoutineSection {
  id        String   @id @default(cuid())
  routineId String
  routine   Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  name      String
  order     Int

  exercises Exercise[]
}

model Exercise {
  id          String         @id @default(cuid())
  sectionId   String
  section     RoutineSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  name        String
  repetitions String
  weight      String?
  series      Int
  youtubeUrl  String?
  order       Int

  feedbacks ExerciseFeedback[]
  logs      ExerciseLog[]
}

model ExerciseFeedback {
  id         String         @id @default(cuid())
  exerciseId String
  exercise   Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  sessionId  String
  session    WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  feedback   String
  createdAt  DateTime       @default(now())

  @@unique([exerciseId, sessionId])
}

model WorkoutSession {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  routineId   String
  routine     Routine   @relation(fields: [routineId], references: [id], onDelete: Cascade)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  sleepHours  Float?
  hrMax       Int?
  hrMin       Int?
  hrAvg       Int?

  feedbacks    ExerciseFeedback[]
  exerciseLogs ExerciseLog[]
}

model ExerciseLog {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId   String
  exercise     Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  sessionId    String
  session      WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseName String
  weight       Float?
  reps         Int?
  series       Int
  loggedAt     DateTime

  @@unique([exerciseId, sessionId])
}

model WellbeingLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score     Int
  createdAt DateTime @default(now())
}

// ── Asistencia y cobros (alumnos presenciales, independiente de User) ─────────

model Cuenta {
  id        String   @id @default(cuid())
  nombre    String
  notas     String?
  createdAt DateTime @default(now())

  alumnos Alumno[]
  pagos   Pago[]
  cargos  Cargo[]
}

model Alumno {
  id               String   @id @default(cuid())
  nombre           String
  cuentaId         String
  cuenta           Cuenta   @relation(fields: [cuentaId], references: [id])
  precioGrupal     Float    @default(0)
  precioIndividual Float?
  abonoMensual     Float?
  abonoDesde       String?  // "YYYY-MM": primer mes que se cobra el abono
  activo           Boolean  @default(true)
  legacyId         String?  @unique // ID de la planilla vieja
  createdAt        DateTime @default(now())

  asistencias Asistencia[]
  cargos      Cargo[]
}

model Asistencia {
  id        String   @id @default(cuid())
  alumnoId  String
  alumno    Alumno   @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  fecha     DateTime // medianoche UTC del día
  tipo      String   // "grupal" | "individual"
  precio    Float    // precio congelado al registrar
  createdAt DateTime @default(now())

  @@unique([alumnoId, fecha, tipo])
  @@index([fecha])
}

model Pago {
  id        String   @id @default(cuid())
  cuentaId  String
  cuenta    Cuenta   @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  fecha     DateTime
  monto     Float
  nota      String?
  createdAt DateTime @default(now())

  @@index([cuentaId])
}

model Cargo {
  id        String   @id @default(cuid())
  cuentaId  String
  cuenta    Cuenta   @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  alumnoId  String?
  alumno    Alumno?  @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  mes       String   // "YYYY-MM"
  concepto  String   // "abono" | texto libre
  monto     Float
  createdAt DateTime @default(now())

  @@unique([alumnoId, mes, concepto])
  @@index([cuentaId])
}
